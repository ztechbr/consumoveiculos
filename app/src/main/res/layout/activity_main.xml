<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/fundo"
    tools:ignore="HardcodedText">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Calculadora Consumo\nFlex - Canivete Suíço"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/title_text_color_dark"
            android:background="@drawable/bg_black_translucido"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="24dp"/>

        <!-- CONTAINER PRINCIPAL -->
        <LinearLayout
            android:id="@+id/containerMain"
            android:orientation="vertical"
            android:background="@drawable/bg_card_translucido"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/txtTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- CONSUMO 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consumo Opção 1 (km/l):"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtResumo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhuma seleção"
                android:textColor="#333333"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/edtConsumo1"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Ex: 9.5"
                    android:inputType="numberDecimal"
                    android:drawableStart="@drawable/ic_gas"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnBuscar1"
                    android:text="Buscar"
                    android:layout_height="48dp"
                    android:layout_width="wrap_content"/>
            </LinearLayout>

            <!-- CONSUMO 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consumo Opção 2 (km/l):"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtResumo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhuma seleção"
                android:textColor="#333333"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/edtConsumo2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Ex: 13.0"
                    android:inputType="numberDecimal"
                    android:drawableStart="@drawable/ic_gas"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnBuscar2"
                    android:text="Buscar"
                    android:layout_height="48dp"
                    android:layout_width="wrap_content"/>
            </LinearLayout>

            <!-- DIVISOR -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#C0C0C0"
                android:layout_marginBottom="24dp"/>

            <!-- PREÇO 1 -->
            <TextView
                android:text="Valor Litro Combustível 1 (R$):"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtPreco1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ex: 6.50"
                android:inputType="numberDecimal"
                android:drawableStart="@drawable/ic_money"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="16dp"/>

            <!-- PREÇO 2 -->
            <TextView
                android:text="Valor Litro Combustível 2 (R$):"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtPreco2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ex: 5.89"
                android:inputType="numberDecimal"
                android:drawableStart="@drawable/ic_money"
                android:background="@android:drawable/edit_text"/>

            <!-- BOTÃO CALCULAR -->
            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Opção mais Econômica"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary_green"
                android:layout_marginTop="32dp"/>

            <!-- RESULTADO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                android:backgroundTint="#FFFFFF">

                <TextView
                    android:id="@+id/txtResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resultado aparecerá aqui"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="16dp"
                    android:textColor="#333333"/>
            </androidx.cardview.widget.CardView>

            <!-- LIMPAR -->
            <Button
                android:id="@+id/btnLimpar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Limpar / Novo Cálculo"
                android:backgroundTint="@color/primary_green"
                android:layout_marginTop="16dp"/>

            <!-- VERSÃO -->
            <TextView
                android:id="@+id/txtVersao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Versao AV - RZ"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginTop="24dp"
                android:layout_gravity="center_horizontal"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
